pipeline {
    agent { label 'WinAgent' }

    environment {
        IMAGE_NAME = '0981987832/wsb'
        IMAGE_TAG  = 'latest'
        COMPOSE_DIR = '/home/ubuntu/workspace/build-wsb-ec2'
    }

    stages {
        stage('Checkout Code') {
            steps {
                git branch: 'develop', url: 'https://github.com/Khachuy911/websellbook-be.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    bat "docker build -t ${IMAGE_NAME}:${IMAGE_TAG} ."
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                script {
                    withDockerRegistry([credentialsId: 'docker-hub', url: '']) {
                        bat "docker push ${IMAGE_NAME}:${IMAGE_TAG}"
                    }
                }
            }
        }

        stage('Deploy to EC2') {
            steps {
                sshagent (credentials: ['ssh-ec2']) {
                    bat """
                        ssh -o StrictHostKeyChecking=no ubuntu@52.63.107.219 << EOF
                            cd ${COMPOSE_DIR}
                            docker-compose pull
                            docker-compose up -d --force-recreate
                        EOF
                    """
                }
            }
        }
    }
}
